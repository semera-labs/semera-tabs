{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "semera-tabs/tab",
  "version": "0.1.1",
  "title": "Tab",
  "category": "design",
  "description": "A single tab of a Tabs block.",
  "parent": [ "semera-tabs/tabs" ],
  "icon": "index-card",
  "textdomain": "semera-tabs",
  "attributes": {
    "title": { "type": "string", "default": "" },
    "icon": { "type": "string", "default": "" },
    "tabId": { "type": "string", "default": "" }
  },
  "usesContext": [ "semera-tabs/uid" ],
  "supports": {
    "html": false,
    "reusable": false,
    "inserter": false,
    "className": false
  }
}
