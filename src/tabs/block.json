{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "semera-tabs/tabs",
  "version": "0.1.1",
  "title": "Tabs",
  "category": "design",
  "description": "Show content in tabs. Every tab can hold any blocks.",
  "keywords": [ "tabs", "accordion", "toggle", "panel" ],
  "icon": "index-card",
  "textdomain": "semera-tabs",
  "styles": [
    { "name": "underline", "label": "Underline", "isDefault": true },
    { "name": "boxed", "label": "Boxed" },
    { "name": "pills", "label": "Pills" }
  ],
  "attributes": {
    "orientation": { "type": "string", "enum": [ "horizontal", "vertical" ], "default": "horizontal" },
    "tabsAlign": { "type": "string", "enum": [ "start", "center", "end", "stretch" ], "default": "start" },
    "iconPosition": { "type": "string", "enum": [ "start", "top", "end" ], "default": "start" },
    "iconSize": { "type": "number" },
    "mobileLayout": { "type": "string", "enum": [ "tabs", "stacked", "accordion" ], "default": "accordion" },
    "mobileBreakpoint": { "type": "number", "default": 600 },
    "tabPaddingX": { "type": "number" },
    "tabPaddingY": { "type": "number" },
    "tabRadius": { "type": "number" },
    "tabGap": { "type": "number" },
    "panelPadding": { "type": "number" },
    "tabFontSize": { "type": "string" },
    "tabFontWeight": { "type": "string" },
    "tabTransform": { "type": "string" },
    "tabColor": { "type": "string" },
    "tabBackground": { "type": "string" },
    "activeTabColor": { "type": "string" },
    "activeTabBackground": { "type": "string" },
    "accentColor": { "type": "string" }
  },
  "supports": {
    "anchor": true,
    "align": [ "wide", "full" ],
    "html": false,
    "color": { "text": true, "background": true, "gradients": true },
    "spacing": { "margin": true, "padding": true },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "fontWeight": true,
      "fontStyle": true,
      "textTransform": true,
      "letterSpacing": true
    },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": true,
    "dimensions": { "minHeight": true }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
